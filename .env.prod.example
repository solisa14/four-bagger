SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=<base64_encoded_256bit_or_longer_secret>
DB_URL=jdbc:postgresql://<rds-host>:5432/<database>?sslmode=require
DB_USERNAME=<your_db_username>
DB_PASSWORD=<your_db_password>
ALLOWED_ORIGINS=https://your.production.origin
REGISTRATION_ENABLED=false
# Optional Bucket4j token-bucket rate limits (defaults shown)
# RATE_LIMIT_AUTH_REQUESTS=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RATE_LIMIT_JOIN_CODE_REQUESTS=30
# RATE_LIMIT_JOIN_CODE_WINDOW_SECONDS=60
# RATE_LIMIT_TRUSTED_PROXIES=<load-balancer-or-reverse-proxy-ip>
